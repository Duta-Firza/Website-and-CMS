# systemd unit for the Duta Firza Next.js standalone server.
# Install: sudo cp deploy/dutafirza.service /etc/systemd/system/dutafirza.service
#          sudo systemctl daemon-reload && sudo systemctl enable --now dutafirza
#
# `current` is a symlink the deploy workflow atomically repoints at each release.
# Runtime secrets live in /opt/dutafirza/shared/.env (chmod 600), NOT in git.

[Unit]
Description=Duta Firza Next.js (standalone)
After=network-online.target mongod.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/dutafirza/current
EnvironmentFile=/opt/dutafirza/shared/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
# Adjust if node is not at /usr/bin/node (e.g. nvm): run `which node`.
ExecStart=/usr/bin/node /opt/dutafirza/current/server.js
Restart=on-failure
RestartSec=5

# Hardening. PrivateTmp gives the process its own /tmp — compress.ts writes
# ffmpeg/pdf temp files there, so it must stay writable (true is fine).
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
